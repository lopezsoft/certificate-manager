    {
      "name": "new request from CSR",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 1. Definimos el CSR manteniendo el formato multilínea",
              "var csr_generated = pm.collectionVariables.get(\"csr\");",
              "",
              "// 2. Codificamos el string a Base64 usando Buffer",
              "var csrBase64 = Buffer.from(csr_generated).toString('base64');",
              "",
              "// 3. Guardamos el resultado en una variable local de la petición (o de entorno)",
              "pm.collectionVariables.set(\"csr_base64_encoded\",csrBase64);",
              "",
              "// (Opcional) Lo imprimimos en la consola de Postman para verificar",
              "console.info(\"CRS codificado en Base64 correctamente.\");",
              "//console.log(\"CSR en Base64:\", csrBase64);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.info(\"Payload enviado: \");",
              "console.info(\"****************\");",
              "",
              "console.info(\"identityType: \" + pm.collectionVariables.get(\"identityType\"));",
              "console.info(\"countryCode: \" + pm.collectionVariables.get(\"countryCode\"));",
              "console.info(\"identity: \" + pm.collectionVariables.get(\"identity\"));",
              "console.info(\"ra: \" + pm.collectionVariables.get(\"COD_RA\"));",
              "console.info(\"codProfile: \" + pm.collectionVariables.get(\"codProfile\"));",
              "console.info(\"emailCertificate: \" + pm.collectionVariables.get(\"emailCertificate\"));",
              "console.info(\"organizationType: \"  + pm.collectionVariables.get(\"organizationType\"));",
              "//console.info(\"csr: \" + pm.collectionVariables.get(\"csr_base64_encoded\"));",
              "",
              "console.info(\"****************\");",
              "const responseData = pm.response.json();",
              "",
              "pm.collectionVariables.set(\"codRequest\", responseData.codRequest);",
              "pm.collectionVariables.set(\"publicId\", responseData.publicId);",
              "",
              "console.info(\"Solicitud creada con código: \" + responseData.codRequest + \" y publicId: \" + responseData.publicId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
