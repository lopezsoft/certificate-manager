      "name": "certificate profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "const responseData = pm.response.json();",
              "",
              "// datos por defecto",
              "",
              "var codProfile = \"VklBRklSTUEtUEktREdJSTtFRV9WSUFGSVJNQV9QSV9ER0lJOzE2MjQ2MjQ1NjM1NjU=\";",
              "var title = \"Certificado Digital Procedimientos Tributarios\";",
              "var description = \"Certificado Digital Procedimientos Tributarios\";",
              "var propertyRfc822 = \"email\";",
              "var validity = \"365\";",
              "var ra = \"viafirmard\";",
              "var type = \"INDIVIDUAL\";",
              "var token = \"P12\";",
              "var dnPattern = \"C=DO,SERIALNUMBER={identityType}{countryCode}-{identity},givenName={name},surname={lastName},CN={name} {lastName},DN=QUALIFIED CERTIFICATE FOR NATURAL PERSON - TAX PROCEDURES\";",
              "var altPattern = \"\";",
              "var terms = \"\";",
              "",
              "// carga de datos",
              "",
              "ra = responseData.items[0].ra;",
              "    console.info(\"ra: \" + ra);",
              "    pm.collectionVariables.set(\"ra\",ra);",
              "title = responseData.items[0].title;",
              "codProfile = responseData.items[0].code;",
              "    console.info(\"codProfile: \" + codProfile);",
              "    pm.collectionVariables.set(\"codProfile\",codProfile);",
              "title = responseData.items[0].title;",
              "    console.info(\"title: \" + title);",
              "    pm.collectionVariables.set(\"title\",title);",
              "description = responseData.items[0].description;",
              "    console.info(\"description: \" + description);",
              "    pm.collectionVariables.set(\"description\",description);",
              "terms = responseData.items[0].terms;",
              "    console.info(\"terms: \" + terms);",
              "    pm.collectionVariables.set(\"terms\",terms);",
              "",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
