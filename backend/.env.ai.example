# AI Configuration Examples
# Add these variables to your .env file

# Google Cloud Vision API Configuration
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_VISION_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_VISION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_content\n-----END PRIVATE KEY-----"
GOOGLE_VISION_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
GOOGLE_VISION_CLIENT_ID=your_client_id

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# AI Processing Settings
AI_MAX_FILE_SIZE=10485760
AI_REQUEST_TIMEOUT=30