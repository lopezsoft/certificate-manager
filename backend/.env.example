APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Certificate File Upload Configuration (sizes in MB)
CERTIFICATE_MAX_FILE_SIZE=10
CERTIFICATE_MAX_TOTAL_SIZE=10

# Personal Access Tokens (PAT)
PAT_EXPIRATION_DAYS=90
PAT_MAX_EXPIRATION_DAYS=365
PAT_MAX_PER_DAY=10
PAT_MAX_ACTIVE=20

# Webhooks
WEBHOOK_QUEUE=webhooks
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_FAILURES=10
WEBHOOK_MAX_ENDPOINTS=5
WEBHOOK_LOG_RETENTION=30

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# -- WOMPI Payment Gateway -------------------------------------------------
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_KEY=
WOMPI_CURRENCY=COP
WOMPI_TAX_PERCENTAGE=19

# -- Google Cloud Vision (OCR) — Sprint 4 --------------------------------
# Si vacías, se usa MockOcrService automáticamente
GOOGLE_VISION_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=

# -- Google Gemini (IA) — Sprint 4 ----------------------------------------
# Si vacías, se usa MockAiAnalysisService automáticamente
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# -- AI Processing Settings -----------------------------------------------
AI_MAX_FILE_SIZE=10485760
AI_REQUEST_TIMEOUT=30

# =====================================================================
# VIAFIRMA RA Colombia (PKCS#10)  Sprint 1
# Todos los endpoints son configurables por entorno. NO hay defaults.
# =====================================================================
VIAFIRMA_RA_URL=
VIAFIRMA_RA_DOWNLOAD_URL=
VIAFIRMA_CLIENT_ID=
VIAFIRMA_CLIENT_SECRET=
VIAFIRMA_RA_CODE=
VIAFIRMA_SANDBOX_MODE=false
# Código de perfil para Persona Jurídica (FE-PJ). Obtenido de GET /ra/available-profiles.
VIAFIRMA_COD_PROFILE_CORPORATE=
# Código de perfil para Persona Natural (FE-PN). Obtenido de GET /ra/available-profiles.
VIAFIRMA_COD_PROFILE_INDIVIDUAL=
VIAFIRMA_HTTP_TIMEOUT=30
VIAFIRMA_HTTP_CONNECT_TIMEOUT=10
VIAFIRMA_CERT_VALIDITY_DAYS=730
VIAFIRMA_KEY_VAULT_DRIVER=encrypted_local
CERT_STORAGE_DISK=local
VIAFIRMA_VAULT_PATH=viafirma/vault
VIAFIRMA_P7B_PATH=viafirma/p7b
VIAFIRMA_P12_PATH=viafirma/p12
VIAFIRMA_LOG_CHANNEL=

# === Certificate Issuance (provider-agnostic) =============================
# Subsistema agn�stico de emisi�n de certificados (mail / viafirma / ...).
# Ver docs/2026-05-19-15-00-PLAN-UNIFICACION-API-V1-Y-PROVEEDOR-AGNOSTICO-VIAFIRMA.md
#
# Proveedor por defecto cuando no hay override por payload ni por empresa.
# Valores soportados: mail | viafirma
CERTIFICATE_ISSUANCE_PROVIDER=mail
# Permite que un caller con rol admin fuerce un proveedor por payload.
# Mantener en false en producci�n salvo necesidad operativa puntual.
CERTIFICATE_ISSUANCE_ALLOW_OVERRIDE=false
# Canal de log dedicado para este subsistema (vac�o = canal por defecto del stack).
CERTIFICATE_ISSUANCE_LOG_CHANNEL=

# ====================================================================
# -- Sync API Configuration -------------------------------------------------
# Variables de entorno para configurar la API de sincronización de certificados.
SYNC_API_KEY=<generar>
SYNC_API_SECRET=<generar>
SYNC_ALLOWED_IPS=              # Opcional: IPs del servidor origen separadas por coma

VIAFIRMA_REVOCATION_GRACE_DAYS=15
