{
  "id": "cert-manager-env-local",
  "name": "Certificate Manager — Local (WAMP64)",
  "_postman_variable_scope": "environment",
  "values": [
    {
      "key": "base_url",
      "value": "http://localhost/certificate-manager/backend/public/api/v1",
      "type": "default",
      "enabled": true,
      "description": "URL base para WAMP64. Ajustar según tu virtual host."
    },
    {
      "key": "token",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Bearer Token — se rellena automáticamente al hacer Login"
    },
    {
      "key": "certificate_request_id",
      "value": "1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "company_id",
      "value": "1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "token_id",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "webhook_id",
      "value": "1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "notification_id",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "order_uuid",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "quota_id",
      "value": "1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "analysis_id",
      "value": "1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "sandbox_mode",
      "value": "true",
      "type": "default",
      "enabled": true,
      "description": "Indica si el servidor tiene VIAFIRMA_SANDBOX_MODE=true activo"
    }
  ]
}
