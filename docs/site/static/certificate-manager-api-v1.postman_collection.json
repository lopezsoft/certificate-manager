    {
      "name": "👤 Perfil",
      "item": [
        {
          "name": "Ver perfil propio",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/profile", "host": ["{{base_url}}"], "path": ["profile"] }
          }
        },
        {
          "name": "Tipos de usuario",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/profile/types", "host": ["{{base_url}}"], "path": ["profile", "types"] }
          }
        },
        {
          "name": "Actualizar perfil",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }],
