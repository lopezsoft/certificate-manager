{
  "info": {
    "name": "Certificate Manager API v1",
    "_postman_id": "certificate-manager-api-v1-2026",
    "description": "API REST unificada para la gestión completa de solicitudes de certificados digitales.\n\n## Proveedores de emisión\n- **mail** — Flujo legacy por correo electrónico\n- **viafirma** — Flujo Zero-Touch PKCS#10 (Viafirma RA)\n\n## Modo Sandbox\nActiva `VIAFIRMA_SANDBOX_MODE=true` en el servidor para usar el `MockViafirmaClient` sin generar certificados reales.\n\n## Autenticación\nUsa `POST /auth/login` y luego asigna la variable `token`. La colección incluye un script que extrae automáticamente el token del login.\n\n## Variables requeridas\n- `base_url`: URL base (ej. `http://localhost/api/v1`)\n- `token`: Bearer Token (se rellena automáticamente con el script del login)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost/api/v1", "type": "string", "description": "URL base del API sin trailing slash" },
    { "key": "token", "value": "", "type": "string", "description": "Bearer Token OAuth2 — se rellena automáticamente al hacer login" },
    { "key": "certificate_request_id", "value": "1", "type": "string", "description": "ID de solicitud de certificado para pruebas" },
    { "key": "company_id", "value": "1", "type": "string" },
    { "key": "user_id", "value": "1", "type": "string" },
    { "key": "token_id", "value": "", "type": "string" },
    { "key": "webhook_id", "value": "1", "type": "string" },
    { "key": "notification_id", "value": "", "type": "string" },
    { "key": "order_uuid", "value": "", "type": "string" },
    { "key": "quota_id", "value": "1", "type": "string" },
    { "key": "analysis_id", "value": "1", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔐 Autenticación",
      "description": "Login, registro, verificación de email y recuperación de contraseña.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.token) {",
                  "        pm.collectionVariables.set('token', body.token);",
                  "        console.log('✅ Token guardado:', body.token.substring(0, 20) + '...');",
                  "    }",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene token', () => pm.expect(pm.response.json()).to.have.property('token'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "description": "Obtiene el Bearer Token OAuth2. El token se guarda automáticamente en la variable `token` de la colección."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] },
            "description": "Revoca el token actual."
          }
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Pérez\",\n  \"email\": \"juan@empresa.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@empresa.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/forgot-password", "host": ["{{base_url}}"], "path": ["forgot-password"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"RESET_TOKEN_FROM_EMAIL\",\n  \"email\": \"juan@empresa.com\",\n  \"password\": \"new_password123\",\n  \"password_confirmation\": \"new_password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/reset-password", "host": ["{{base_url}}"], "path": ["reset-password"] }
          }
        },
        {
          "name": "Sync Account [ERP]",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Sync-Signature", "value": "HMAC_SIGNATURE_HERE" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@empresa.com\",\n  \"name\": \"Juan Pérez\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/sync-account", "host": ["{{base_url}}"], "path": ["sync-account"] },
            "description": "Sincronización de cuenta inter-sistema (ERP). Requiere middleware de firma HMAC."
          }
        }
      ]
    },
    {
      "name": "📋 Datos Maestros (público)",
      "description": "Endpoints públicos sin autenticación: países, departamentos, ciudades, tipos de documento.",
      "item": [
        {
          "name": "Países",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/countries", "host": ["{{base_url}}"], "path": ["countries"] }
          }
        },
        {
          "name": "Departamentos",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/departments", "host": ["{{base_url}}"], "path": ["departments"] }
          }
        },
        {
          "name": "Ciudades",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/cities", "host": ["{{base_url}}"], "path": ["cities"] }
          }
        },
        {
          "name": "Tipos de Documento de Identidad",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/identity-documents", "host": ["{{base_url}}"], "path": ["identity-documents"] }
          }
        },
        {
          "name": "Tipos de Organización DIAN",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/organization-type", "host": ["{{base_url}}"], "path": ["organization-type"] }
          }
        },
        {
          "name": "Tipos de Documento de Entidad",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/entity-document-types", "host": ["{{base_url}}"], "path": ["entity-document-types"] }
          }
        }
      ]
    },
    {
      "name": "📄 Solicitudes de Certificado",
      "description": "CRUD de solicitudes de certificados digitales.",
      "item": [
        {
          "name": "Crear solicitud",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    const id = body?.dataRecords?.id || body?.data?.id;",
                  "    if (id) pm.collectionVariables.set('certificate_request_id', id);",
                  "}",
                  "pm.test('Creación exitosa', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city_id\": 149,\n  \"identity_document_id\": 1,\n  \"type_organization_id\": 1,\n  \"document_number\": \"1234567890\",\n  \"address\": \"Calle 123 # 45-67\",\n  \"legal_representative\": \"JUAN PÉREZ GÓMEZ\",\n  \"legal_rep_first_name\": \"JUAN PABLO\",\n  \"legal_rep_last_name\": \"PÉREZ GÓMEZ\",\n  \"legal_rep_email\": \"juan.perez@empresa.com\",\n  \"company_name\": \"MI EMPRESA S.A.S.\",\n  \"dni\": \"900455420\",\n  \"life\": 1,\n  \"info\": \"Información adicional\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/certificate-request", "host": ["{{base_url}}"], "path": ["certificate-request"] }
          }
        },
        {
          "name": "Listar mis solicitudes",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/certificate-request", "host": ["{{base_url}}"], "path": ["certificate-request"] }
          }
        },
        {
          "name": "Listar todas (admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/certificate-request/all", "host": ["{{base_url}}"], "path": ["certificate-request", "all"] }
          }
        },
        {
          "name": "Buscar por DNI",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/certificate-request/lookup/900455420", "host": ["{{base_url}}"], "path": ["certificate-request", "lookup", "900455420"] }
          }
        },
        {
          "name": "Estadísticas por empresa",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/certificate-request/stats/{{company_id}}", "host": ["{{base_url}}"], "path": ["certificate-request", "stats", "{{company_id}}"] }
          }
        },
        {
          "name": "Obtener por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}"] }
          }
        },
        {
          "name": "Historial de cambios",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/history", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "history"] }
          }
        },
        {
          "name": "Actualizar solicitud",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"Carrera 10 # 20-30\",\n  \"legal_rep_email\": \"nuevo@empresa.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}"] }
          }
        },
        {
          "name": "Actualizar estado",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_status\": \"ACCEPTED\",\n  \"comments\": \"Documentación revisada y aprobada.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/status", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "status"] }
          }
        },
        {
          "name": "Eliminar solicitud",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}"] }
          }
        }
      ]
    },
    {
      "name": "📎 Archivos Adjuntos",
      "description": "Carga y eliminación de archivos adjuntos a solicitudes de certificado.",
      "item": [
        {
          "name": "Subir archivo",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "description": "Archivo PDF o ZIP" },
                { "key": "document_type", "value": "ATTACHED", "type": "text" }
              ]
            },
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/files", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "files"] },
            "description": "Sube un archivo adjunto (PDF/ZIP, máx 7MB por archivo, 10MB total, máx 3 archivos)."
          }
        },
        {
          "name": "Eliminar archivo",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/files/1", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "files", "1"] }
          }
        }
      ]
    },
    {
      "name": "🚀 Emisión de Certificados",
      "description": "Emisión agnóstica del proveedor. El sistema resuelve automáticamente si usa 'mail' o 'viafirma' según la configuración.",
      "item": [
        {
          "name": "Emitir certificado [mail]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comments\": \"Solicitud expedita por convenio empresarial\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/issue", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "issue"] },
            "description": "Usa el proveedor 'mail' (default). Solo requiere archivos adjuntos tipo ATTACHED."
          }
        },
        {
          "name": "Emitir certificado [viafirma sandbox]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email_certificate\": \"rep.legal@empresa.com\",\n  \"organization_type\": null,\n  \"identity_type_override\": null,\n  \"comments\": \"Emisión Zero-Touch vía Viafirma RA (sandbox)\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/issue", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "issue"] },
            "description": "Usa el proveedor 'viafirma'. Requiere VIAFIRMA_PKCS10_ENABLED=true y email_certificate. En sandbox (VIAFIRMA_SANDBOX_MODE=true) no genera certificado real."
          }
        },
        {
          "name": "Emitir con override de proveedor [admin]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"viafirma\",\n  \"email_certificate\": \"rep.legal@empresa.com\",\n  \"organization_type\": \"RM\",\n  \"comments\": \"Override forzado por admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/issue", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "issue"] },
            "description": "Fuerza un proveedor específico. Requiere rol admin y CERTIFICATE_ISSUANCE_ALLOW_OVERRIDE=true."
          }
        },
        {
          "name": "Consultar estado del trámite",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const status = body?.dataRecords?.status;",
                  "pm.test('Tiene status normalizado', () => pm.expect(['sent','submitted','processing','ready','completed','failed','unsupported']).to.include(status));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/issuance", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "issuance"] },
            "description": "Devuelve el estado normalizado: sent/submitted/processing/ready/completed/failed. Para Viafirma incluye internal_state, remote_status, public_id."
          }
        },
        {
          "name": "Metadata de descarga P12 (Viafirma)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/issuance/download", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "issuance", "download"] },
            "description": "Retorna PIN temporal y URL firmada (24h) para descargar el .p12. Solo disponible cuando internal_state = ASSEMBLED o COMPLETED."
          }
        },
        {
          "name": "Descarga P12 en Base64",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/issuance/download/base64", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "issuance", "download", "base64"] },
            "description": "Devuelve el .p12 codificado en Base64 + PIN. Para uso desatendido/automatizado."
          }
        },
        {
          "name": "Re-descargar P12 con nuevo PIN [admin]",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/issuance/redownload", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "issuance", "redownload"] },
            "description": "Re-descarga el P7B de Viafirma y regenera el P12 con un nuevo PIN. Solo administradores."
          }
        },
        {
          "name": "Renovar certificado (generar orden)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/issuance/renew", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "issuance", "renew"] },
            "description": "Genera una orden de pago WOMPI para renovar la vigencia del certificado por 1 año adicional."
          }
        }
      ]
    },
    {
      "name": "🔏 Viafirma (KYC y Revocación)",
      "description": "Operaciones específicas del proveedor Viafirma RA.",
      "item": [
        {
          "name": "Obtener link KYC",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/kyc-link", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "kyc-link"] },
            "description": "Retorna el link del portal de acreditación biométrica KYC. Solo disponible cuando remote_status = 'accreditation'."
          }
        },
        {
          "name": "Revocar certificado",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"revoking_code\": \"MOCK-REV-CODE-A1B2C3D4\",\n  \"revocation_reason\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/certificate-request/{{certificate_request_id}}/revoke", "host": ["{{base_url}}"], "path": ["certificate-request", "{{certificate_request_id}}", "revoke"] },
            "description": "Revoca el certificado Viafirma. Motivos: 0=unspecified, 1=keyCompromise, 2=cACompromise, 3=affiliationChanged, 4=superseded, 5=cessationOfOperation, 9=privilegeWithdrawn, 10=aACompromise."
          }
        }
      ]
    },
