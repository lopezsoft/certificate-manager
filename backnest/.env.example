# ─── Aplicación ──────────────────────────────────────────────────────────────
APP_NAME="Certificate Manager API"
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Bogota

# ─── Base de datos ──────────────────────────────────────────────────────────
# Migración desde Laravel: usar DB_TYPE=mariadb (mismo motor)
# En Docker: DB_HOST=mariadb (nombre del servicio)
DB_TYPE=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=secret
DB_DATABASE=certificate_manager
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── JWT ────────────────────────────────────────────────────────────────────
# IMPORTANTE: Laravel usa Passport (tokens opacos). Al migrar a NestJS (JWT),
# todos los usuarios deberán re-autenticarse. Generar un secreto fuerte.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=90d

# ─── Personal Access Tokens ────────────────────────────────────────────────
# Equivalente a PAT_EXPIRATION_DAYS de Laravel
TOKEN_EXPIRATION_DAYS=90
TOKEN_MAX_EXPIRATION_DAYS=365
TOKEN_MAX_PER_DAY=10
TOKEN_MAX_ACTIVE=20

# ─── Email ──────────────────────────────────────────────────────────────────
# NOTA: NestJS usa MAIL_USER/MAIL_PASS (no MAIL_USERNAME/MAIL_PASSWORD de Laravel)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=noreply@certificate-manager.com
MAIL_FROM_NAME="Certificate Manager"

# ─── Certificados ──────────────────────────────────────────────────────────
CERTIFICATE_ADMIN_EMAIL=soporte@matias.com.co
CERTIFICATE_NOTIFICATION_DAYS=30
CERTIFICATE_DAILY_NOTIFICATIONS_ENABLED=true

# ─── AWS ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_TEXTRACT_REGION=us-east-1

# ─── Google AI ──────────────────────────────────────────────────────────────
GOOGLE_VISION_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── AI/OCR ────────────────────────────────────────────────────────────────
AI_OCR_SERVICE=textract

# ─── Redis ──────────────────────────────────────────────────────────────────
# En Docker: REDIS_HOST=redis (nombre del servicio)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Webhooks ───────────────────────────────────────────────────────────────
WEBHOOK_QUEUE=webhooks
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_FAILURES=10
WEBHOOK_MAX_ENDPOINTS_PER_COMPANY=5
WEBHOOK_DELIVERY_LOG_RETENTION_DAYS=30

# ─── Storage (Manejo de Archivos) ──────────────────────────────────────────
# Ruta base del storage. Default: {cwd}/storage/app
# En Docker el default es /app/storage/app (correcto con bind mounts).
#
# COMPATIBILIDAD CON LARAVEL:
#   La estructura de archivos es idéntica. Solo copiar los directorios:
#     Laravel:  storage/app/attachments/  →  NestJS: storage/app/attachments/
#     Laravel:  storage/app/pdf/          →  NestJS: storage/app/pdf/
#
#   file_path en BD: companies/1/2025/04/100092351/doc.pdf (sin cambios)
#   URL pública:     {APP_URL}/attachments/{file_path}     (sin cambios)
#
# STORAGE_PATH=/app/storage/app

# ─── Swagger ────────────────────────────────────────────────────────────────
# Desactivar en producción
SWAGGER_ENABLED=true
