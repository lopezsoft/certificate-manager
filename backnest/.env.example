# Aplicación
APP_NAME="Certificate Manager API"
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Bogota

# Base de datos
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=certificate_manager
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=90d

# Personal Access Tokens
TOKEN_EXPIRATION_DAYS=90
TOKEN_MAX_EXPIRATION_DAYS=365
TOKEN_MAX_PER_DAY=10
TOKEN_MAX_ACTIVE=20

# Email
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=noreply@certificate-manager.com
MAIL_FROM_NAME="Certificate Manager"

# Certificados
CERTIFICATE_ADMIN_EMAIL=soporte@matias.com.co
CERTIFICATE_NOTIFICATION_DAYS=30
CERTIFICATE_DAILY_NOTIFICATIONS_ENABLED=true

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_TEXTRACT_REGION=us-east-1

# Google AI
GOOGLE_VISION_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# AI/OCR
AI_OCR_SERVICE=textract

# Redis (para Queue, Cache, Sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Webhooks
WEBHOOK_QUEUE=webhooks
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_FAILURES=10
WEBHOOK_MAX_ENDPOINTS_PER_COMPANY=5
WEBHOOK_DELIVERY_LOG_RETENTION_DAYS=30

# Storage
STORAGE_DISK=local
STORAGE_PUBLIC_PATH=./public

# Swagger
SWAGGER_ENABLED=true
